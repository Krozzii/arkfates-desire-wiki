<div class="editorial-landing">
  {% if sectionKind == "biblioteca" %}
  {% include "components/library-catalog.njk" %}
  {% elif sectionKind == "novedades" %}
  <p class="editorial-intro">Anuncios y novedades oficiales del proyecto.</p>
  <p class="editorial-empty">Todavía no hay novedades publicadas.</p>
  {% elif sectionKind == "comunidad" %}
  <p class="editorial-intro">La comunidad oficial de ArkFates Desiré se organizará en Discord.</p>
  {% if meta.discordInviteUrl %}
  <p><a class="editorial-action" href="{{ meta.discordInviteUrl }}" target="_blank" rel="noopener noreferrer">Unirse a la comunidad</a></p>
  {% else %}
  <p class="editorial-empty">El acceso al servidor aparecerá cuando se configure la invitación oficial.</p>
  {% endif %}
  {% elif sectionKind == "acerca" %}
  <p class="editorial-intro">ArkFates Desiré es una obra original creada por Krozzii.</p>
  <p>Este sitio es el espacio oficial para sus relatos y para la información autorizada de su universo.</p>
  {% endif %}
</div>
