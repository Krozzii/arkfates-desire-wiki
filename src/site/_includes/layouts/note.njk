---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---
<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}" data-theme="dark" data-theme-preference="dark">
  <head>
    <title>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</title>
    {%include "components/pageheader.njk"%}
    {% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.head" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.head %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.head %}
      {% include imp %}
    {% endfor %}
  </head>
  <body class="theme-{{meta.baseTheme}} markdown-preview-view markdown-rendered markdown-preview-section {% if page.url == '/' %}arkfates-home{% endif %} {% if editorialType %}arkfates-editorial{% endif %} {% if editorialType and 'encyclopedia' in editorialType %}arkfates-encyclopedia{% endif %} {% if libraryType %}library-page library-page-{{ libraryType }}{% endif %} {% if settings.dgShowFileTree !== true %}no-filetree{% endif %} {% if settings.dgHomeLink === true and settings.dgShowFileTree !== true %}has-navbar{% endif %} {{meta.bodyClasses}}">
    <a class="public-skip-link" href="#main-content">Saltar al contenido</a>
    {%include "components/notegrowthhistory.njk"%}

    {% set regionName = "navigation" %}
    {% set regionFallback = "components/navbar.njk" %}
    {% include "components/pluginRegion.njk" %}

    <main id="main-content" class="content cm-s-obsidian print {{contentClasses}}">
      {% if libraryType %}
      <nav class="editorial-breadcrumbs library-breadcrumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/biblioteca/">Biblioteca</a>
        {% if libraryType == "volume" or libraryType == "chapter" %}
          {% set libraryWork = collections.library.works | libraryById(libraryWorkId) %}
          <span aria-hidden="true">/</span>
          <a href="{{ libraryWork.url }}">{{ libraryWork.data.title }}</a>
        {% endif %}
        {% if libraryType == "chapter" %}
          {% set libraryVolume = collections.library.volumes | libraryById(libraryVolumeId) %}
          <span aria-hidden="true">/</span>
          <a href="{{ libraryVolume.url }}">{{ libraryVolume.data.title }}</a>
        {% endif %}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ title }}</span>
      </nav>
      {% elif editorialType %}
      <nav class="editorial-breadcrumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        {% if editorialType == "encyclopediaDirectory" %}
          <span aria-current="page">Enciclopedia</span>
        {% elif editorialType == "encyclopediaCategory" %}
          <a href="/enciclopedia/">Enciclopedia</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        {% elif editorialType == "encyclopediaEntry" %}
          <a href="/enciclopedia/">Enciclopedia</a>
          <span aria-hidden="true">/</span>
          <a href="/enciclopedia/{{ encyclopediaCategory }}/">{{ encyclopediaCategoryTitle }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        {% elif editorialType == "newsArticle" %}
          <a href="/novedades/">Novedades</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        {% else %}
          <span aria-current="page">{{ title }}</span>
        {% endif %}
      </nav>
      {% endif %}
      <header>
        {% if settings.dgShowInlineTitle === true and not libraryType %}
          <h1 data-note-icon="{% if noteIcon %}{{noteIcon}}{% else %}{{meta.noteIconsSettings.default}}{% endif %}">{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</h1>
        {% endif %}
        <div class="header-meta">
          {% if settings.dgShowTags === true and tags %}
            <div class="header-tags">
              {% for tag in tags %}
                {% if tag != 'gardenEntry' and tag !='note' %}
                  <a class="tag">
                    #{{tag}}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.header" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.header %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.header %}
        {% include imp %}
      {% endfor %}
      </header>
      {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% if libraryType == "work" %}
        {% include "components/library-work.njk" %}
      {% elif libraryType == "volume" %}
        {% include "components/library-volume.njk" %}
      {% elif libraryType == "chapter" %}
        {% include "components/library-reader.njk" %}
      {% elif editorialType == "encyclopediaDirectory" %}
        {% include "components/encyclopedia-directory.njk" %}
      {% elif editorialType == "encyclopediaCategory" %}
        {% include "components/encyclopedia-category.njk" %}
      {% elif editorialType == "encyclopediaEntry" %}
        {% include "components/encyclopedia-entry.njk" %}
      {% elif editorialType == "newsArticle" %}
        {% include "components/news-article.njk" %}
      {% elif editorialType == "landing" %}
        {% include "components/editorial-landing.njk" %}
      {% else %}
        {{ content | hideDataview | taggify | link | resolveMdLinks | safe}}
      {% endif %}
      {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.afterContent %}
        {% include imp %}
      {% endfor %}
    </main>

    {% if settings.dgShowBacklinks === true or settings.dgShowLocalGraph === true or settings.dgShowToc === true or dynamics.sidebar.top.length > 0 or dynamics.sidebar.bottom.length > 0 or plugins.slots["sidebar.top"] or plugins.slots["sidebar.bottom"] %}
      {%include "components/sidebar.njk"%}
    {% endif %}
    {% include "components/floatingActions.njk" %}

    {% include "components/references.njk" %}
    {% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.footer" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.footer %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.footer %}
      {% include imp %}
    {% endfor %}
    {%include "components/lucideIcons.njk"%}
    {% if contentClasses and "canvas-page" in contentClasses %}
      {%include "components/canvasScript.njk"%}
    {% endif %}
    {% include "components/basesScript.njk" %}
    {% include "components/excalidrawScript.njk" %}
  </body>
</html>
