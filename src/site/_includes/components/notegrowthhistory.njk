{%- if collections.versionednote.length > 0 -%}
    <aside class="notegrowth-history" aria-label="Historial de crecimiento de la nota">
        <h2>Notegrowth</h2>
        <ul>
            {%- for note in collections.versionednote -%}
                {%- if note.data.item.title === page.fileSlug -%}
                    <li>
                        <a href="{{ note.url }}">
                            {{note.data.item.date}}</a>
                    </li>
                {%- endif -%}
            {%- endfor -%}
        </ul>
    </aside>
    {%-endif-%}
