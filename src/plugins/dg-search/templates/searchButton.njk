{% if settings.dgEnableSearch === true %}
<button type="button" class="search-button align-icon" onclick="toggleSearch()" aria-label="{{ meta.uiStrings.searchButtonText }}" aria-controls="globalsearch" aria-haspopup="dialog" aria-expanded="false" aria-keyshortcuts="Control+K Meta+K">
    <span class="search-icon" aria-hidden="true">
        <i data-lucide="search" aria-hidden="true"></i>
    </span>
    <span class="search-text">{{ meta.uiStrings.searchButtonText }}</span>
    <span class="search-keys"><code>Ctrl</code>&nbsp;+&nbsp;<code>K</code></span>
</button>
{% endif %}
